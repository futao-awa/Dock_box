{
  "name": "dock_box",
  "version": "1.1.0",
  "description": "A calm, customizable Windows desktop dock.",
  "main": "dist-electron/main.cjs",
  "author": "futao-awa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futao-awa/Dock_box.git"
  },
  "homepage": "https://github.com/futao-awa/Dock_box#readme",
  "bugs": {
    "url": "https://github.com/futao-awa/Dock_box/issues"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:native": "node scripts/smoke-native.mjs",
    "test:launch": "node scripts/smoke-launch.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-desktop.mjs",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win portable nsis --x64 --publish never --config.electronDist=node_modules/electron/dist",
    "pack:win": "npm run build && electron-builder --win --dir",
    "test:migration": "node scripts/smoke-migration.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "com.futao.dockbox",
    "productName": "dock_box",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/app.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/native",
        "to": "native",
        "filter": [
          "*.exe"
        ]
      }
    ],
    "win": {
      "icon": "assets/app.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "dock_box-${version}-${arch}-setup.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "dock_box-${version}-portable.exe"
    }
  }
}
